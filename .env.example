# OpenAI-compatible model server.
MODEL_BASE_URL=http://127.0.0.1:8080

# Optional. If omitted, the app uses the first model returned by /v1/models.
MODEL_NAME=

# Optional bearer token for model servers that require authentication.
MODEL_API_KEY=

# Directory the model may access with file tools. Defaults to ./model_workspace.
MODEL_FILE_ROOT=model_workspace

# Persistent model state. Defaults to .harness_state.json inside MODEL_FILE_ROOT.
MODEL_STATE_FILE=

# Terminal execution: sandbox (default), host, or disabled.
MODEL_TERMINAL_MODE=sandbox

# Local Docker image used by sandbox mode. Build it with:
# docker build -t tff-harness-sandbox:latest -f sandbox/Dockerfile .
MODEL_SANDBOX_IMAGE=tff-harness-sandbox:latest

# Authoritative agent-run state. Must remain outside MODEL_FILE_ROOT.
MODEL_AGENT_STATE_FILE=

# Fixed supervised-agent execution budgets.
AGENT_MAX_TOOL_ROUNDS=32
AGENT_MAX_TOOL_CALLS=64
AGENT_MAX_SECONDS=900
AGENT_MAX_CONSECUTIVE_FAILURES=3

# Browser-facing app server.
APP_HOST=127.0.0.1
APP_PORT=8000
